class Solution {
  public:
    void insertionSort(vector<int>& arr) {
        // code here
        for(int i=0;i<=arr.size()-1;i++){
          //  int j=i;
          //  while(j>0 && arr[j-1]>arr[j])
          for(int j=i; arr[j-1]>arr[j];j--)
            {
                int temp= arr[j-1];
                arr[j-1]=arr[j];
                arr[j]=temp;
                
               // j--;
            }
        }
    }
};
