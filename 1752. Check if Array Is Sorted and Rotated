class Solution {
public:
 int c=0;
    bool check(vector<int>& nums) {
       
        for(int i=0;i<nums.size()-1;i++){
            if(nums[i]>nums[i+1]){
                c++;
            }
        }
        if(nums[nums.size()-1]>nums[0]){
                c++;
            }
        return c<=1;
    }
    
};
